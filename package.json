{
  "name": "qos-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild scripts/video-worker.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/video-worker.cjs --log-level=warning",
    "build:ai-worker": "esbuild scripts/ai-worker.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/ai-worker.cjs --log-level=warning --alias:@=./src --external:sharp",
    "start": "next start",
    "worker:video": "tsx scripts/video-worker.ts",
    "worker:ai": "tsx scripts/ai-worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-dev.ts",
    "db:seed:quotes-checkout-tester": "tsx scripts/seed-quotes-checkout-tester.ts",
    "verify:stripe-sandbox": "tsx scripts/verify-stripe-sandbox.ts",
    "verify:qos-57": "tsx scripts/verify-qos-57-rollback.ts",
    "verify:qos-47-48": "tsx scripts/verify-qos-47-48.ts",
    "export:quotes-hbz-finedine": "tsx scripts/export-quotes-hbz-finedine-fixture.ts",
    "import:quotes-hbz-finedine": "tsx scripts/import-quotes-hbz-finedine-menu.ts",
    "approve-publish:quotes-hbz-finedine": "tsx scripts/approve-publish-quotes-hbz-finedine-menu.ts",
    "audit:ci": "tsx scripts/ci-npm-audit.ts",
    "agents:connect-hyperagent": "tsx scripts/connect-hyperagent.ts",
    "agents:approve-binding": "tsx scripts/approve-agent-binding.ts",
    "ai:spend": "tsx scripts/ai-spend-operator-cli.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/agents": "0.18.0",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.469.0",
    "next": "16.3.8",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
