# Local development — copy to .env and adjust as needed
DATABASE_URL="postgresql://qos:qos@localhost:5432/qos"

# Privileged URL for administrative CLI imports (qosadmin). Do not point the
# application DATABASE_URL at this user — the app continues to use qos_app.
# DATABASE_ADMIN_URL="postgresql://qosadmin:qosadmin@localhost:5432/qos"

# Optional. Defaults to 10. Used by the long-running Container Apps process.
# DB_POOL_MAX=10

# Azure Container Apps (from Key Vault secrets)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Platform operator provisioning (local development only)
# PLATFORM_OPERATOR_API_KEY=

# OpenAI (local AI features). Put the real key in .env — never commit it.
# OPENAI_API_KEY=

# Storefront customer authentication (better-auth)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# Staff authentication (better-auth; falls back to BETTER_AUTH_* when unset)
# STAFF_BETTER_AUTH_SECRET=
# STAFF_BETTER_AUTH_URL=http://localhost:3000
# STAFF_INVITATION_TTL_SECONDS=604800
# CUSTOMER_AUTH_TRUSTED_RETURN_ORIGINS=http://localhost:3000,https://*.dev.qosapp.com
# CUSTOMER_SESSION_MAX_AGE_SECONDS=604800

# Optional OAuth providers for customer sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Stripe sandbox checkout (backend only — never commit real keys)
# PAYMENTS_PROVIDER=stripe
# PAYMENTS_MODE=sandbox
# STRIPE_CURRENCY=AED
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2024-11-20.acacia
# STRIPE_CHECKOUT_SUCCESS_URL=https://your-storefront/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://your-storefront/checkout/cancelled
# CHECKOUT_PAYMENT_RETURN_BASE_URL=http://localhost:3000
# CHECKOUT_PAYMENT_ALLOWED_RETURN_ORIGINS=http://localhost:3000
# CHECKOUT_FIXTURE_WEBHOOK_SECRET=

# Product media storage (defaults to local disk for local/dev/tests only).
# Unset MEDIA_STORAGE fails readiness on Azure Container Apps / production.
# MEDIA_STORAGE=local
# MEDIA_LOCAL_ROOT=.local-media
# MEDIA_MAX_UPLOAD_BYTES=5000000
# MEDIA_MAX_PIXEL_DIMENSION=4096
# MEDIA_UPLOAD_GRANT_TTL_SECONDS=900

# Azure Blob media storage (Container Apps — shared across replicas)
# Prefer Entra ID / Managed Identity. Shared-key connection strings are
# development-only and fail when the storage account disables key auth.
# MEDIA_STORAGE=azure-blob
# MEDIA_AZURE_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
# MEDIA_AZURE_BLOB_CONTAINER=
# MEDIA_AZURE_BLOB_PRIVATE_CONTAINER=media-private
# MEDIA_AZURE_BLOB_PUBLIC_CONTAINER=media-public
# MEDIA_AZURE_BLOB_PREFIX=
# MEDIA_AZURE_BLOB_CONNECTION_STRING=
# After switching from local/ephemeral disk, re-ingest HBZ images onto blob:
#   npm run import:quotes-hbz-finedine -- --live --force-image-reingest --idempotency-key=hbz-blob-$(date +%s)
#   npm run approve-publish:quotes-hbz-finedine

# Product video worker (npm run worker:video; needs ffmpeg + ffprobe on PATH).
# Upload limits (20 MiB / 25 s / 1920x1080 / h264,h265) are owner-locked and
# intentionally not listed here.
# VIDEO_MAX_CONCURRENT_JOBS=2
# VIDEO_MAX_ACTIVE_JOBS_PER_TENANT=1
# VIDEO_MAX_RETRIES=3
# VIDEO_RETRY_BACKOFF_MS=30000
# VIDEO_JOB_TIMEOUT_MS=300000
# VIDEO_JOB_LEASE_MS=420000
# VIDEO_WORKER_POLL_INTERVAL_MS=5000
