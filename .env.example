# Local development — copy to .env and adjust as needed
DATABASE_URL="postgresql://qos:qos@localhost:5432/qos"

# Privileged URL for administrative CLI imports (qosadmin). Do not point the
# application DATABASE_URL at this user — the app continues to use qos_app.
# DATABASE_ADMIN_URL="postgresql://qosadmin:qosadmin@localhost:5432/qos"

# Optional. Defaults to 10. Used by the long-running Container Apps process.
# DB_POOL_MAX=10

# Azure Container Apps (from Key Vault secrets)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Platform operator provisioning (local development only)
# PLATFORM_OPERATOR_API_KEY=

# OpenAI (local AI features). Put the real key in .env — never commit it.
# OPENAI_API_KEY=

# AI menu photos (QOS-140). Off by default: no paid image call is made unless
# AI_PHOTOS_ENABLED=true and OPENAI_API_KEY is set. Candidates stay private
# until an administrator accepts them. Attempts count towards the per-tenant
# rolling 24-hour limit, including failures that may have been billed
# (timeouts, unusable output); requests the provider refused or that were
# proven never sent (bad key, rate limit, refused connection) do not.
# AI_PHOTOS_ENABLED=false
# openai (default) or mock (local placeholder images, no network; refused in production)
# AI_PHOTO_PROVIDER=openai
# AI_PHOTO_MODEL=gpt-image-1
# AI_PHOTO_QUALITY=low
# AI_PHOTO_DAILY_LIMIT_PER_TENANT=20
# AI_PHOTO_REQUEST_TIMEOUT_MS=120000
# sync (default) generates inside the request. queued_worker only admits
# requests (single or batch) and the AI worker generates them; it needs the
# AI_SPEND_AI_PHOTO_ASYNC_* spend policy and a running worker, which then also
# needs the AI_PHOTO_* and MEDIA_* settings and OPENAI_API_KEY. It never falls
# back to sync.
# AI_PHOTO_EXECUTION_MODE=sync
# Queued requests no worker has claimed by then are cancelled and released.
# AI_PHOTO_QUEUED_STALE_MS=600000
# Operator spend reconciliation never reads .env. Set DATABASE_URL and pass --database-host.
# Totals are application quotas, not an invoice ceiling. Nothing is deleted.
# npm run ai:spend -- usage --database-host <host> [--tenant <tenantId>] [--path ai_photo.async]
# npm run ai:spend -- due-uncertain --database-host <host> [--tenant <tenantId>]
# npm run ai:spend -- resolve --database-host <host> --tenant <tenantId> --reservation spr_... --resolution billed|not_billed --reason "..." --operator you@company

# Storefront customer authentication (better-auth)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# Staff authentication (better-auth; falls back to BETTER_AUTH_* when unset)
# STAFF_BETTER_AUTH_SECRET=
# STAFF_BETTER_AUTH_URL=http://localhost:3000
# STAFF_INVITATION_TTL_SECONDS=604800
# CUSTOMER_AUTH_TRUSTED_RETURN_ORIGINS=http://localhost:3000,https://*.dev.qosapp.com
# CUSTOMER_SESSION_MAX_AGE_SECONDS=604800

# Optional OAuth providers for customer sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Stripe sandbox checkout (backend only — never commit real keys)
# PAYMENTS_PROVIDER=stripe
# PAYMENTS_MODE=sandbox
# STRIPE_CURRENCY=AED
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2024-11-20.acacia
# STRIPE_CHECKOUT_SUCCESS_URL=https://your-storefront/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://your-storefront/checkout/cancelled
# CHECKOUT_PAYMENT_RETURN_BASE_URL=http://localhost:3000
# CHECKOUT_PAYMENT_ALLOWED_RETURN_ORIGINS=http://localhost:3000
# CHECKOUT_FIXTURE_WEBHOOK_SECRET=

# Product media storage (defaults to local disk for local/dev/tests only).
# Unset MEDIA_STORAGE fails readiness on Azure Container Apps / production.
# MEDIA_STORAGE=local
# MEDIA_LOCAL_ROOT=.local-media
# MEDIA_MAX_UPLOAD_BYTES=5000000
# MEDIA_MAX_PIXEL_DIMENSION=4096
# MEDIA_UPLOAD_GRANT_TTL_SECONDS=900

# Azure Blob media storage (Container Apps — shared across replicas)
# Prefer Entra ID / Managed Identity. Shared-key connection strings are
# development-only and fail when the storage account disables key auth.
# MEDIA_STORAGE=azure-blob
# MEDIA_AZURE_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
# MEDIA_AZURE_BLOB_CONTAINER=
# MEDIA_AZURE_BLOB_PRIVATE_CONTAINER=media-private
# MEDIA_AZURE_BLOB_PUBLIC_CONTAINER=media-public
# MEDIA_AZURE_BLOB_PREFIX=
# MEDIA_AZURE_BLOB_CONNECTION_STRING=
# After switching from local/ephemeral disk, re-ingest HBZ images onto blob:
#   npm run import:quotes-hbz-finedine -- --live --force-image-reingest --idempotency-key=hbz-blob-$(date +%s)
#   npm run approve-publish:quotes-hbz-finedine

# Product video worker (npm run worker:video; needs ffmpeg + ffprobe on PATH).
# Upload limits (20 MiB / 25 s / 1920x1080 / h264,h265) are owner-locked and
# intentionally not listed here.
# VIDEO_MAX_CONCURRENT_JOBS=2
# VIDEO_MAX_ACTIVE_JOBS_PER_TENANT=1
# VIDEO_MAX_RETRIES=3
# VIDEO_RETRY_BACKOFF_MS=30000
# VIDEO_JOB_TIMEOUT_MS=300000
# VIDEO_JOB_LEASE_MS=420000
# VIDEO_WORKER_POLL_INTERVAL_MS=5000

# Dedicated AI worker (Dockerfile target ai-worker / npm run worker:ai). Off
# until AI_WORKER_ENABLED and every cap below are set; there are no defaults.
# The process must use a login granted only qos_ai_worker, never qos_app.
# AI_WORKER_ENABLED=false
# AI_WORKER_CONCURRENCY=8
# AI_WORKER_MAX_ACTIVE_GLOBAL=8
# AI_WORKER_MAX_ACTIVE_PER_TENANT=3
# AI_WORKER_MAX_ACTIVE_PER_KIND=8
# AI_WORKER_LEASE_MS=60000
# AI_WORKER_POLL_INTERVAL_MS=5000

# AI agents (QOS-139). Off by default: no provider call is made unless both
# flags are true. The Hyperagent connection is platform-scoped and set up by an
# operator, never by a tenant.
# AGENTS_ENABLED=false
# AGENT_MENU_MANAGER_ENABLED=false
# native (default) or hyperagent. Unset execution mode is queued_worker when
# native and inline when Hyperagent. Native still needs the
# AI_SPEND_MENU_MANAGER_NATIVE_* policy and a model. It does not use a
# Hyperagent binding and never falls back to Hyperagent. Opt in to Hyperagent
# with AGENT_MENU_MANAGER_EXECUTOR=hyperagent. Existing runs keep the executor
# they were admitted with.
# AGENT_MENU_MANAGER_EXECUTOR=native
# AGENT_MENU_MANAGER_EXECUTION_MODE=queued_worker
# AGENT_NATIVE_MODEL_PROVIDER=openai
# AGENT_NATIVE_MODEL=gpt-4.1-mini
# HYPERAGENT_MCP_URL=https://hyperagent.com/api/mcp
# Operators connect the platform account with npm run agents:connect-hyperagent
# and approve a tenant's agent with npm run agents:approve-binding (see --help).
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts provider OAuth
# tokens at rest with AES-256-GCM. In Azure, inject from Key Vault; rotating it
# requires reconnecting the provider.
# AGENT_CREDENTIAL_ENCRYPTION_KEY=
# AGENT_RUN_POLL_INTERVAL_MS=5000
# AGENT_RUN_POLL_LEASE_MS=30000
# AGENT_RUN_TIMEOUT_MS=600000
# AGENT_RUN_QUEUED_STALE_MS=120000
